# Backstop — credentials & config manifest. Copy to .env and fill in.

# ── RPC ──
MANTLE_RPC_URL=https://your-3rd-party-rpc/mantle-sepolia   # QuickNode/Alchemy/Tenderly free tier (polling/writes); public RPC is used for eth_call sim

# ── keys (generate with: cast wallet new) ──
DEPLOYER_KEY=0x...                  # deploys the factory; fund from faucet.sepolia.mantle.xyz
DEPLOYER_ADDRESS=0x...              # address derived from DEPLOYER_KEY
GUARDIAN_KEY=0x...                  # keeper co-sign/veto key (veto-only on-chain); fund a little MNT for veto gas
GUARDIAN_ADDRESS=0x...              # address derived from GUARDIAN_KEY
GUARDIAN_AGENT_ID=                  # ERC-8004 identity id registered for the guardian
DEMO_AGENT_KEY=0x...                # demo agent owner key; fund MNT (gas) — seed wraps 2 WMNT into its account
DEMO_AGENT_ADDRESS=0x...            # address derived from DEMO_AGENT_KEY
DEMO_ACCOUNT_AGENT_ID=             # ERC-8004 identity id registered for the guarded account

# ── deployed (fill after Deploy.s.sol + seed) ──
FACTORY_ADDRESS=0x...
RECOVERY_DELAY_BLOCKS=150           # ~5 min @ 2s blocks

# ── demo targets ──
STATIC_DRAINERS=0x...,0x...         # comma-sep known-drainer list; MUST include DEMO_EVIL_ADDRESS
DEMO_EVIL_ADDRESS=0x...             # unlimited-approval drainer (also in STATIC_DRAINERS)
DEMO_UNKNOWN_ADDRESS=0x...          # a DEPLOYED unverified contract (must have bytecode)
DEMO_INJECTED_SPENDER=0x...         # a stranger spender, NOT in STATIC_DRAINERS (falls back to DEMO_UNKNOWN_ADDRESS)

# ── LLM provider (pluggable; OpenAI-compatible) ──
# PRIMARY = AltLLM (OpenAI-SDK compatible: base URL + Bearer key).
LLM_BASE_URL=https://api.altllm.ai/v1   # OpenAI-compatible chat/completions endpoint
LLM_API_KEY=                            # provider API key (platform.altllm.ai → API Keys)
LLM_MODEL=altllm-basic                  # free-tier accessible model with high-reasoning mode
# FALLBACK = direct Anthropic Claude (used when the primary provider errors or runs out of credits)
LLM_FALLBACK=anthropic                  # provider id for the fallback path
ANTHROPIC_API_KEY=sk-ant-...            # fallback Tier-B LLM key
ANTHROPIC_MODEL=claude-sonnet-4-6       # fallback model

# ── Threat intel (optional) ──
THREATINTEL_API_KEY=                # blank => automatic known-drainer list fallback (ethereum-lists)
THREATINTEL_API_URL=                # optional live provider base URL; blank => offline list only

# ── service URLs ──
# Onboarding default in code (shared/addresses.ts) is the HOSTED guardian keeper
# (https://backstop-keeper.onrender.com) — Mode A, zero infra. For LOCAL dev, set KEEPER_URL back to
# localhost (below) so seed/agent scripts hit your own `npm run keeper`. Self-hosting (Mode B) sets it
# to your own keeper. On Render the keeper reads env from the dashboard, not this file.
KEEPER_URL=http://localhost:8787
KEEPER_PORT=8787
NEXT_PUBLIC_KEEPER_URL=http://localhost:8787   # set to the hosted keeper URL in production
NEXT_PUBLIC_DEMO_ACCOUNT=0x...      # prefilled guarded account in /sandbox (set by seed-demo)
